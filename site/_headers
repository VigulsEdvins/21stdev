# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# Checked by `npm run check-headers` (this file) and, against a live address, `npm run check-headers -- https://staging.edvlabs.com`.
# The Turnstile spam check needs https://challenges.cloudflare.com in script-src and frame-src; it is allowed only on /account/*, /contact/* and /start/*.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=300, must-revalidate

# "! Cache-Control" first: without it Cloudflare ADDS these to the 300 seconds set for everything, and the browser gets two conflicting values.
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Scripts and styles are checked with the server on every load (a cheap "not modified" answer when nothing changed), so a new deploy shows at once.
/js/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/*.css
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/style/*
  X-Robots-Tag: noindex
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'

/examples/*
  X-Robots-Tag: noindex

# The three whole websites build parts of their pages with inline styles, play audio and show their own pages in the admin preview.
# Scripts stay as strict as everywhere else. "!" removes the strict policy from /* first: a second policy would be added to it, not replace it.
/examples/yearbook/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; frame-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests

/examples/arena/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; frame-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests

/examples/roster/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; frame-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests

# The account page talks to Supabase (sign-in) and can show Cloudflare Turnstile (the spam check, loaded only when a site key is configured). Same strict rules as
# everywhere, plus: that one Supabase address for connect-src, and challenges.cloudflare.com for script-src and frame-src. Nothing else is loosened.
# The address is public (it is in every sign-in redirect). "!" removes the strict policy from /* first, because a second policy would be added to it, not replace it.
/account/*
  X-Robots-Tag: noindex
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://idvirglyjvqneaudnsuu.supabase.co; frame-src https://challenges.cloudflare.com; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# The contact page and the start questions send a message to /api/lead and show the Cloudflare spam check (Turnstile) when a site key is configured
# (js/spam-check.js). Same strict rules as everywhere, plus challenges.cloudflare.com for script-src and frame-src. Nothing else is loosened.
# "!" removes the strict policy from /* first, because a second policy would be added to it, not replace it.
/contact/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://challenges.cloudflare.com; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

/start/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://challenges.cloudflare.com; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# The builder (staged under /builder/ by scripts/build-site.js). Its page also carries a fallback policy tag for hosts that send no headers; this header is the
# real one. Nobody may frame the builder, and search engines skip it.
# The builder page runs under the strict policy (docs/security/builder-csp.md, measured by scripts/check-builder-csp.js).
/builder/*
  X-Robots-Tag: noindex
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: data: blob:; frame-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# The preview frame is its own page (preview-frame/, see scripts/builder/frame-doc.js). The page written into it keeps THIS policy, which is
# what lets the blocks run their own inline scripts and styles without weakening the builder page above. It is the old builder policy, nothing wider.
/builder/preview-frame/
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' data: blob: https:; frame-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# The catalogue cards in the builder show each component in a small frame of the builder itself (features/<slug>/index.html), so those files may be framed by
# the same site, and only by it. Without this rule the framing ban above blocks them too and every card preview shows "blocked".
/builder/features/*
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'self'
