{
  // The Worker that shows client design previews at <name>--pv.edvlabs.com. Plan: docs/superpowers/plans/2026-11-16-previews-subdomain-worker.md.
  // Deploy: npx wrangler deploy -c wrangler.previews.jsonc  (only after the route check described in the plan; remove it again with: npx wrangler delete -c wrangler.previews.jsonc).
  // Kept apart from wrangler.jsonc and wrangler.sites.jsonc so a mistake here cannot touch the main site or customers' sites.
  "name": "edv-previews",
  "main": "src/previews-worker.js",
  "compatibility_date": "2026-10-28",
  // Customer site names cannot contain "--" (functions/lib/payment.js), so nothing ending in "--pv" is a customer's address. The sites Worker's "*.edvlabs.com/*" and "*/*" stay untouched.
  "routes": [{ "pattern": "*--pv.edvlabs.com/*", "zone_name": "edvlabs.com" }],
  // run_worker_first: the Worker maps host -> folder; the files are never reachable by their own path. "none": no automatic index/redirect rules, the Worker does that itself.
  "assets": { "directory": "previews", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" }
}
