{
  // The Worker that serves published sites at <name>.edvlabs.com and at customers' own domains. Deploy: npx wrangler deploy -c wrangler.sites.jsonc (steps and owner set-up: docs/deploy/publish-sites.md, written in step 8 of the plan).
  // Kept apart from wrangler.jsonc so a mistake here cannot touch leads, sign-in or the public pages.
  "name": "edvlabs-sites",
  "main": "src/sites-worker.js",
  "compatibility_date": "2026-10-28",
  // Only addresses with exactly one name in front of edvlabs.com. The bare domain and any address with its own route (www, and others added later) are more specific and keep going where they go now.
  // Customers' own domains (docs/deploy/publish-sites.md, "Own domains") need the second route, "*/*": Cloudflare for SaaS sends a customer's host name through this zone, and only a "*/*" route sees it. Live since 2026-10-31. It also catches the bare domain, so the main Worker MUST keep its own explicit "edvlabs.com/*" route (wrangler.jsonc); without it the main site answers 404. The first route is more specific and keeps winning for <name>.edvlabs.com.
  "routes": [{ "pattern": "*.edvlabs.com/*", "zone_name": "edvlabs.com" }, { "pattern": "*/*", "zone_name": "edvlabs.com" }],
  // The KV namespace and the R2 bucket MUST be the same ones the main Worker publishes into, so both are named here by id. The KV namespace was created 2026-10-30 (id below, not secret); the same id goes into wrangler.jsonc.
  // The R2 bucket is created with: npx wrangler r2 bucket create edvlabs-sites
  "kv_namespaces": [{ "binding": "SITES", "id": "3ec1a308b9914c22ba2cc075f0f3b690" }],
  "r2_buckets": [{ "binding": "SITES_BUCKET", "bucket_name": "edvlabs-sites" }]
}
