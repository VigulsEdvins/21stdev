{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "edvlabs brief_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "answers"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "path": {
      "enum": [
        "self",
        "done",
        "talk"
      ]
    },
    "pending": {
      "type": "boolean"
    },
    "sent": {
      "type": "boolean"
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unknown"
          ],
          "properties": {
            "value": {
              "enum": [
                "business",
                "self",
                "event",
                "product",
                "other",
                null,
                ""
              ]
            },
            "unknown": {
              "type": "boolean"
            },
            "note": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "kind": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unknown"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            },
            "unknown": {
              "type": "boolean"
            },
            "note": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unknown"
          ],
          "properties": {
            "value": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "enum": [
                  "call",
                  "book",
                  "buy",
                  "signup",
                  "read",
                  "see"
                ]
              },
              "uniqueItems": true
            },
            "unknown": {
              "type": "boolean"
            },
            "note": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "blocks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unknown"
          ],
          "properties": {
            "value": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "enum": [
                  "banner",
                  "about",
                  "services",
                  "prices",
                  "gallery",
                  "reviews",
                  "faq",
                  "contact",
                  "map",
                  "newsletter",
                  "team",
                  "process"
                ]
              },
              "uniqueItems": true
            },
            "unknown": {
              "type": "boolean"
            },
            "note": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "editor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unknown"
          ],
          "properties": {
            "value": {
              "enum": [
                "yes",
                "no",
                null,
                ""
              ]
            },
            "unknown": {
              "type": "boolean"
            },
            "note": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unknown"
          ],
          "properties": {
            "value": {
              "enum": [
                "all",
                "some",
                "none",
                null,
                ""
              ]
            },
            "unknown": {
              "type": "boolean"
            },
            "note": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "feel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unknown"
          ],
          "properties": {
            "value": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "enum": [
                  "calm",
                  "warm",
                  "bold",
                  "playful",
                  "serious",
                  "elegant",
                  "simple",
                  "friendly"
                ]
              },
              "uniqueItems": true,
              "maxItems": 3
            },
            "unknown": {
              "type": "boolean"
            },
            "note": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "languages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unknown"
          ],
          "properties": {
            "value": {
              "enum": [
                "1",
                "2",
                "3",
                null,
                ""
              ]
            },
            "unknown": {
              "type": "boolean"
            },
            "note": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "hosting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unknown"
          ],
          "properties": {
            "value": {
              "enum": [
                "both",
                "domain",
                "hosting",
                "neither",
                null,
                ""
              ]
            },
            "unknown": {
              "type": "boolean"
            },
            "note": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unknown"
          ],
          "properties": {
            "value": {
              "enum": [
                "week",
                "month",
                "later",
                null,
                ""
              ]
            },
            "unknown": {
              "type": "boolean"
            },
            "note": {
              "type": "string",
              "maxLength": 500
            }
          }
        }
      }
    }
  },
  "description": "Also checked by site/js/brief.js: when unknown is true the value must be empty."
}
